# /etc/systemd/system/campbell-serial-bridge.service
#
# The Campbell station's serial fan-out. A unit rather than a `screen` session, so that it
# survives a reboot -- and a unit of its own rather than the distribution's `ser2net.service`
# with an edited `/etc/ser2net.yaml`, so that a `pacman -Syu` cannot take the station off the
# air and so that this bridge's lifecycle is the one the runbook describes.
#
# `ser2net.yaml` beside this file is its configuration; `README.md` is the cutover and the
# rollback. On pitcairn (Arch) the binary comes from `extra/ser2net`.

[Unit]
Description=Serial fan-out for the Campbell datalogger (GRA-787)
Documentation=https://github.com/chrissnell/modernweather/tree/main/packaging/serial-bridge
# The accepter binds a specific address, so the interface has to be up first. Nothing is
# ordered against the device: ser2net starts and listens with the cable unplugged and opens
# the device when a client arrives, which is measured and is what makes a replug a non-event.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# -n keeps it in the foreground, which is what Type=exec requires and what makes the
# journal the log.
ExecStart=/usr/bin/ser2net -n -c /etc/ser2net/campbell.yaml
Restart=always
RestartSec=5

# Not root: a bridge that is only a reader of one character device has no use for privilege,
# and this is the process that now stands between the station and both daemons. The user is
# not created by the Arch package -- README.md step 1 creates it.
#
# BOTH group names on purpose. Arch puts serial devices in `uucp`; Debian and the other
# units in this tree use `dialout`. A group that does not exist is a startup failure, so
# check which one owns the device (`ls -l /dev/ttyS0`) and drop the other.
User=ser2net
Group=ser2net
SupplementaryGroups=uucp dialout

# SIGTERM, and this is not the default-by-accident kind. gensio takes uucp locks under
# /run/lock and only removes them on a clean exit; a SIGKILL leaves them behind and the next
# start then answers its clients `Device open failure: Object was already in use`. SIGKILL
# remains the escalation after the timeout, which is why the README says to check
# /run/lock/LCK..* after an unclean stop.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The uucp lock, and nothing else writable.
ReadWritePaths=/run/lock
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=

# Serial devices only, and by SUBSYSTEM rather than by a glob. The other units in this tree
# write `DeviceAllow=/dev/ttyUSB*`; `DeviceAllow=` matches a device node path, a
# `char-<subsystem>` name or a major:minor pair, and whether that glob form expands was not
# verified by this item -- so it is avoided here rather than relied on. `char-tty` covers
# every tty device, which is wider than this service needs and is still nothing but ttys,
# and it removes the question of which spelling the station turns out to have.
#
# A missing entry is an EPERM at the open, which looks like a cabling fault.
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=char-tty rw

# No SystemCallFilter, deliberately. The daemon units in this tree set
# `SystemCallFilter=@system-service`, and the same line here is untested: this item has no
# access to pitcairn, and a filter that turns out to block one of gensio's tty ioctls would
# leave the station unread for a reason that looks like a hardware fault. Adding it is a
# one-line change for whoever is next on the box, with the bridge running and the station
# served either way.

LimitNOFILE=4096
TasksMax=32

StandardOutput=journal
StandardError=journal
SyslogIdentifier=campbell-serial-bridge

[Install]
WantedBy=multi-user.target
