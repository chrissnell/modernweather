    "body": "<!DOCTYPE html>\n<html data-wf-page=\"weather\" data-wf-site=\"weather-station\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Suncrest Live Weather - Weather Station</title>\n  <meta content=\"width=device-width, initial-scale=1\" name=\"viewport\">\n  <meta name=\"apple-itunes-app\" content=\"app-id=6755874087\">\n  <link rel=\"icon\" type=\"image/png\" href=\"/favicon-96x96.png\" sizes=\"96x96\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\" />\n  <link rel=\"shortcut icon\" href=\"/favicon.ico\" />\n  <link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"/apple-touch-icon.png\" />\n  <link rel=\"manifest\" href=\"/site.webmanifest\" />\n  <link href=\"css/normalize.css\" rel=\"stylesheet\" type=\"text/css\">\n  <link href=\"css/fonts.css\" rel=\"stylesheet\" type=\"text/css\">\n  <link href=\"css/weather.css\" rel=\"stylesheet\" type=\"text/css\">\n\n  \n  \n  <link href=\"https://unpkg.com/maplibre-gl@5/dist/maplibre-gl.css\" rel=\"stylesheet\" crossorigin=\"anonymous\">\n  <script defer src=\"https://unpkg.com/maplibre-gl@5/dist/maplibre-gl.js\" crossorigin=\"anonymous\"></script>\n  <script defer src=\"js/weather-radar.js\"></script>\n  \n\n  \n  <link rel=\"preconnect\" href=\"https://code.highcharts.com\">\n  \n  \n  <script defer src=\"https://code.highcharts.com/highcharts.js\"></script>\n  <script defer src=\"https://code.highcharts.com/modules/accessibility.js\"></script>\n  <script defer src=\"https://code.highcharts.com/modules/vector.js\"></script>\n  \n  \n  <script src=\"js/moment.min.js\"></script>\n  \n  \n  <script>\n    \n    (function() {\n      const savedTheme = localStorage.getItem('weather-theme');\n      const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;\n      \n      \n      let theme = savedTheme;\n      if (!theme) {\n        theme = systemPrefersDark ? 'dark' : 'light';\n      }\n      \n      if (theme === 'light') {\n        document.documentElement.setAttribute('data-theme', 'light');\n      }\n    })();\n  </script>\n  \n  \n  <script src=\"js/weather-utils.js\"></script>\n  <script src=\"js/weather-charts.js\"></script>\n  <script src=\"js/weather-forecast-band.js\"></script>\n  <script src=\"js/weather-data-service.js\"></script>\n  <script src=\"js/weather-dom.js\"></script>\n  <script src=\"js/weather-app.js\"></script>\n</head>\n<body class=\"weather-body\">\n  \n  \n  \n  \n  \n  <div class=\"weather-header\">\n    <div class=\"weather-container\">\n      <div class=\"header-content\">\n        <h1 class=\"station-name\">Suncrest Live Weather</h1>\n        <div class=\"header-status\">\n          <div class=\"status-line\">\n            <div class=\"div-block-11\" id=\"live-indicator-dot\"></div>\n            <div class=\"live-indicator\">\n              <div class=\"text-block-23\">LIVE</div>\n            </div>\n            <div class=\"last-update\" id=\"last-update\">Updated just now</div>\n            <button class=\"theme-toggle\" id=\"theme-toggle\" title=\"Toggle light/dark theme\">\n              <span>Theme</span>\n            </button>\n          </div>\n          <div class=\"battery-info\" id=\"battery-info\">\n            Station Battery: <span id=\"battery-voltage\">--</span>V (<span id=\"battery-status\">--</span>)\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"weather-main\">\n    <div class=\"weather-container\">\n      \n      \n      <div class=\"metric-groups\">\n        \n        \n        <div class=\"metric-group\">\n          <div class=\"group-title\">TEMPERATURE & ATMOSPHERIC</div>\n          <div class=\"group-metrics\">\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Temperature</div>\n              <div class=\"metric-value large\" id=\"temperature\">--</div><span class=\"metric-unit\">\u00b0F</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Feels Like</div>\n              <div class=\"metric-value\" id=\"feels-like\">--</div><span class=\"metric-unit\">\u00b0F</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Humidity</div>\n              <div class=\"metric-value\" id=\"humidity\">--</div><span class=\"metric-unit\">%</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Dew Point</div>\n              <div class=\"metric-value\" id=\"dew-point\">--</div><span class=\"metric-unit\">\u00b0F</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Barometer</div>\n              <div class=\"metric-value\" id=\"barometer\">--</div><span class=\"metric-unit\">inHg</span>\n            </div>\n            <div id=\"solar-moon-container\">\n              <div class=\"metric-item\" id=\"solar-card\">\n                <div class=\"metric-label\">Solar Radiation</div>\n                <div class=\"metric-value\" id=\"solar\">--</div><span class=\"metric-unit\">W/m\u00b2</span>\n              </div>\n              <div class=\"metric-item\" id=\"moon-card\" style=\"display:none\">\n                <div class=\"metric-label\">Moon Phase</div>\n                <div class=\"metric-value\" id=\"moon-phase\">--</div>\n                <div class=\"metric-sub\" id=\"moon-illumination\">--</div>\n              </div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Sky Conditions</div>\n              <div class=\"metric-value\" id=\"sky-conditions\">--</div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Sunrise / Sunset</div>\n              <div class=\"metric-value\" id=\"sun-times\">--</div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"metric-group\">\n          <div class=\"group-title\">WIND</div>\n          <div class=\"group-metrics wind-group\">\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Speed</div>\n              <div class=\"metric-value large\" id=\"wind-speed\">--</div><span class=\"metric-unit\">MPH</span>\n              <div class=\"metric-sub\">Gusts: <span id=\"wind-gusts\">--</span> MPH</div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Direction</div>\n              <div class=\"metric-value\" id=\"wind-direction\">--</div>\n              <div class=\"metric-sub\" id=\"wind-degrees\">(--\u00b0)</div>\n            </div>\n            <div class=\"windrosecontainer\">\n              <div class=\"windrose-box measurement-part\">\n                <div class=\"div-block-3\">\n                  <div class=\"windrose-box-container\">\n                    <div class=\"windrose-bezel\">\n                      <div class=\"bezel-label bezel-n\">N</div>\n                      <div class=\"bezel-label bezel-ne\">NE</div>\n                      <div class=\"bezel-label bezel-e\">E</div>\n                      <div class=\"bezel-label bezel-se\">SE</div>\n                      <div class=\"bezel-label bezel-s\">S</div>\n                      <div class=\"bezel-label bezel-sw\">SW</div>\n                      <div class=\"bezel-label bezel-w\">W</div>\n                      <div class=\"bezel-label bezel-nw\">NW</div>\n                    </div>\n                    <div id=\"rdg-winddir\" class=\"windrose-circle\">\n                      <div class=\"windrose-arrow\"></div>\n                    </div>\n                    <div id=\"rdg-windspeed-display\" class=\"wind-speed-center\">--</div>\n                    <div id=\"rdg-winddir-cardinal\" class=\"wind-direction-center\">--</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        \n        <div class=\"metric-group\">\n          <div class=\"group-title\">RAINFALL</div>\n          <div class=\"group-metrics\">\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Today's Rain</div>\n              <div class=\"metric-value\" id=\"rain-today\">--</div><span class=\"metric-unit\">in</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Rain Rate</div>\n              <div class=\"metric-value\" id=\"rain-rate\">--</div><span class=\"metric-unit\">in/hr</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Rain 24HR</div>\n              <div class=\"metric-value\" id=\"rain-24hr\">--</div><span class=\"metric-unit\">in</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Rain 48HR</div>\n              <div class=\"metric-value\" id=\"rain-48hr\">--</div><span class=\"metric-unit\">in</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Rain 72HR</div>\n              <div class=\"metric-value\" id=\"rain-72hr\">--</div><span class=\"metric-unit\">in</span>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">Storm Total</div>\n              <div class=\"metric-value\" id=\"rain-storm-total\">--</div><span class=\"metric-unit\">in</span>\n            </div>\n          </div>\n        </div>\n\n        \n      </div>\n      \n      \n      \n      <div class=\"metric-group span-full\">\n        <div class=\"metric-group-header\">\n          <div class=\"group-title\">SNOW GAUGE</div>\n        </div>\n        <div class=\"metric-group-content\">\n          <div class=\"metric-item\">\n            <div class=\"metric-label\">Snow Depth</div>\n            <div class=\"metric-value\" id=\"snow-depth\">--</div><span class=\"metric-unit\">in</span>\n          </div>\n          <div class=\"metric-item\">\n            <div class=\"metric-label\">Snow 24hr</div>\n            <div class=\"metric-value\" id=\"snow-24hr\">--</div><span class=\"metric-unit\">in</span>\n          </div>\n          <div class=\"metric-item\">\n            <div class=\"metric-label\">72 Hour Snowfall</div>\n            <div class=\"metric-value\" id=\"snow-72hr\">--</div><span class=\"metric-unit\">in</span>\n          </div>\n          <div class=\"metric-item\">\n            <div class=\"metric-label\">Storm Total</div>\n            <div class=\"metric-value\" id=\"snow-storm-total\">--</div><span class=\"metric-unit\">in</span>\n          </div>\n          <div class=\"metric-item\">\n            <div class=\"metric-label\">Season Total</div>\n            <div class=\"metric-value\" id=\"snow-season-total\">--</div><span class=\"metric-unit\">in</span>\n          </div>\n          <div class=\"metric-item\">\n            <div class=\"metric-label\">Accumulation Rate</div>\n            <div class=\"metric-value\" id=\"snow-accumulation-rate\">--</div><span class=\"metric-unit\">in/hr</span>\n          </div>\n        </div>\n      </div>\n      \n      \n      \n      \n      <div class=\"radar-aq-row\">\n        \n        <div class=\"metric-group span-full aq-block\">\n          <div class=\"group-title\">AIR QUALITY</div>\n          <div class=\"group-metrics air-quality-metrics\">\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">\n                PM2.5\n                <span class=\"info-icon\" data-tooltip=\"pm25\">\u24d8</span>\n              </div>\n              <div class=\"metric-value\" id=\"pm25\">--</div><span class=\"metric-unit\">\u00b5g/m\u00b3</span>\n              <div class=\"metric-status\" id=\"pm25-status\"></div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">\n                PM10\n                <span class=\"info-icon\" data-tooltip=\"pm10\">\u24d8</span>\n              </div>\n              <div class=\"metric-value\" id=\"pm10\">--</div><span class=\"metric-unit\">\u00b5g/m\u00b3</span>\n              <div class=\"metric-status\" id=\"pm10-status\"></div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">\n                PM1.0\n                <span class=\"info-icon\" data-tooltip=\"pm1\">\u24d8</span>\n              </div>\n              <div class=\"metric-value\" id=\"pm1\">--</div><span class=\"metric-unit\">\u00b5g/m\u00b3</span>\n              <div class=\"metric-status\" id=\"pm1-status\"></div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">\n                CO\u2082\n                <span class=\"info-icon\" data-tooltip=\"co2\">\u24d8</span>\n              </div>\n              <div class=\"metric-value\" id=\"co2\">--</div><span class=\"metric-unit\">ppm</span>\n              <div class=\"metric-status\" id=\"co2-status\"></div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">\n                TVOC Index\n                <span class=\"info-icon\" data-tooltip=\"tvoc\">\u24d8</span>\n              </div>\n              <div class=\"metric-value\" id=\"tvoc\">--</div>\n              <div class=\"metric-status\" id=\"tvoc-status\"></div>\n            </div>\n            <div class=\"metric-item\">\n              <div class=\"metric-label\">\n                NOx Index\n                <span class=\"info-icon\" data-tooltip=\"nox\">\u24d8</span>\n              </div>\n              <div class=\"metric-value\" id=\"nox\">--</div>\n              <div class=\"metric-status\" id=\"nox-status\"></div>\n            </div>\n          </div>\n        </div>\n        \n        \n        <section id=\"radar-section\" class=\"radar-block\">\n          <div class=\"group-title\">LIVE RADAR</div>\n          <div id=\"radar-map\" class=\"is-loading\"></div>\n          <div id=\"radar-controls\">\n            <button type=\"button\" id=\"radar-play\">Play</button>\n            <button type=\"button\" id=\"radar-reset\">Reset</button>\n            <input type=\"range\" id=\"radar-scrubber\" min=\"0\" max=\"0\" value=\"0\" aria-label=\"Radar frame\">\n            <span id=\"radar-timestamp\">--</span>\n          </div>\n          <script id=\"radar-config\" type=\"application/json\">\n            {\"lat\":  39.9 , \"lon\":  -105.5 , \"token\": \"contract-radar-token\", \"widthMiles\": 200}\n          </script>\n        </section>\n        \n      </div>\n      \n      \n      \n      \n      <div class=\"forecast-section\">\n        <div class=\"section-title\">Weather Forecast</div>\n        \n        <div class=\"forecast-tabs\">\n          <button class=\"forecast-tab active\" data-forecast-type=\"week\" id=\"forecast-tab-week\">10 Days</button>\n          <button class=\"forecast-tab\" data-forecast-type=\"day\" id=\"forecast-tab-day\">24 Hours</button>\n        </div>\n        \n        \n        <div class=\"forecast-container\" id=\"forecast-week\">\n          <div class=\"fc-head\">\n            <div class=\"fc-kicker\">Ten-Day Outlook &middot; Suncrest Live Weather</div>\n            <div class=\"fc-key\">\n              <div class=\"fc-key-bar\"></div>\n              <div class=\"fc-key-ticks\">\n                <span>10&deg;</span><span>32&deg;</span><span>50&deg;</span><span>68&deg;</span><span>86&deg;</span><span>105&deg;</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"fc-plot\" id=\"fc-week-plot\">\n            <div class=\"fc-today\" id=\"fc-week-today\"></div>\n            <div class=\"fc-hover\" id=\"fc-week-hover\"></div>\n            <div class=\"fc-row fc-icons\" id=\"fc-week-icons\"></div>\n            <div class=\"fc-row fc-cond\" id=\"fc-week-cond\"></div>\n            <div class=\"fc-band\" id=\"fc-week-band\"><canvas></canvas><svg></svg></div>\n            <div class=\"fc-row fc-days\" id=\"fc-week-days\"></div>\n            <div class=\"fc-row fc-precip\" id=\"fc-week-precip\"></div>\n            <div class=\"fc-card\" id=\"fc-week-card\"></div>\n            <div class=\"fc-empty\" id=\"fc-week-empty\">Loading forecast&hellip;</div>\n          </div>\n          <div class=\"fc-foot\">\n            <div class=\"fc-legend\">Band = daily high to low, colored by temperature &middot; <b>Bar</b> = chance of precip &middot; <b>Number</b> = expected accumulation</div>\n            <div class=\"forecast-updated\" id=\"forecast-week-last-updated\">---</div>\n          </div>\n        </div>\n\n        \n        <div class=\"forecast-container\" id=\"forecast-day\" style=\"display: none;\">\n          <div class=\"fc-head\">\n            <div class=\"fc-kicker\">Next 24 Hours &middot; Suncrest Live Weather</div>\n            <div class=\"fc-key\">\n              <div class=\"fc-key-bar\"></div>\n              <div class=\"fc-key-ticks\">\n                <span>10&deg;</span><span>32&deg;</span><span>50&deg;</span><span>68&deg;</span><span>86&deg;</span><span>105&deg;</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"fc-plot\" id=\"fc-day-plot\">\n            <div class=\"fc-nights\" id=\"fc-day-nights\"></div>\n            <div class=\"fc-hover\" id=\"fc-day-hover\"></div>\n            <div class=\"fc-row fc-icons\" id=\"fc-day-icons\"></div>\n            <div class=\"fc-band\" id=\"fc-day-band\"><canvas></canvas><svg></svg></div>\n            <div class=\"fc-row fc-days\" id=\"fc-day-hours\"></div>\n            <div class=\"fc-row fc-precip\" id=\"fc-day-precip\"></div>\n            <div class=\"fc-card\" id=\"fc-day-card\"></div>\n            <div class=\"fc-empty\" id=\"fc-day-empty\">Loading forecast&hellip;</div>\n          </div>\n          <div class=\"fc-foot\">\n            <div class=\"fc-legend\">Area = hourly temperature, colored by temperature &middot; night hours shaded &middot; <b>Bar</b> = chance of precip</div>\n            <div class=\"forecast-updated\" id=\"forecast-day-last-updated\">---</div>\n          </div>\n        </div>\n      </div>\n      \n      \n      \n      <div class=\"charts-section\">\n        <div class=\"section-title\">Historical Data</div>\n        \n        <div class=\"chart-controls\">\n          <div class=\"chart-tabs\">\n            <button class=\"chart-tab active\" data-range=\"24h\" id=\"tab-24h\">24 Hours</button>\n            <button class=\"chart-tab\" data-range=\"72h\" id=\"tab-72h\">72 Hours</button>\n            <button class=\"chart-tab\" data-range=\"7d\" id=\"tab-7d\">Week</button>\n            <button class=\"chart-tab\" data-range=\"30d\" id=\"tab-30d\">Month</button>\n            <button class=\"chart-tab\" data-range=\"1y\" id=\"tab-1y\">Year</button>\n          </div>\n        </div>\n        \n        \n        <div class=\"charts-container\">\n          \n          <div class=\"chart-range-container\" id=\"charts-24h\">\n            <div class=\"chart-wrapper\">\n              <div class=\"chart-title\">Temperature</div>\n              <div class=\"chart-container\" id=\"temperatureChart24h\"></div>\n            </div>\n            <div class=\"chart-wrapper\">\n              <div class=\"chart-title\">Wind Speed</div>\n              <div class=\"chart-container\" id=\"windspeedChart24h\"></div>\n            </div>\n            <div class=\"chart-wrapper\">\n              <div class=\"chart-title\">Wind Direction</div>\n              <div class=\"chart-container-wind\" id=\"winddirectionChart24h\"></div>\n            </div>\n            <div class=\"chart-wrapper\">\n              <div class=\"chart-title\">Humidity</div>\n              <div class=\"chart-container\" id=\"humidityChart24h\"></div>\n            </div>\n            <div class=\"chart-wrapper\">\n              <div class=\"chart-title\">Barometer</div>\n              <div class=\"chart-container\" id=\"barome